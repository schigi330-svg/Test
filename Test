function negRed(width){
  width=Math.min(Math.max(width,0),100);
  if(width>=85)return '#5f0000';
  if(width>=70)return '#8b0000';
  if(width>=55)return '#b00000';
  if(width>=40)return '#d00000';
  return '#ff3b3b';
}

function bar(p,h,areaOrImpact,impactMaybe){
  h=h||10;
  const val=Number(p)||0;
  const area=(typeof areaOrImpact==='string')?areaOrImpact:undefined;
  const im=(typeof areaOrImpact==='number')?areaOrImpact:Number(impactMaybe||0);
  if(im<0||val<0){
    const w=im<0?negImpactWidth(im):Math.min(Math.abs(val),100);
    const c=negRed(w);
    return `<div class="bar-wrap" style="height:${h}px;position:relative;background:rgba(255,255,255,0.10);border-radius:6px;overflow:hidden">
      <div style="position:absolute;left:50%;top:0;bottom:0;width:1px;background:rgba(255,255,255,.22);z-index:4"></div>
      <div class="bar-fill" style="width:${w}%;height:100%;background:${c};box-shadow:0 0 10px ${c}aa;margin-left:auto;border-radius:6px 0 0 6px;position:relative;z-index:2"></div>
    </div>`;
  }
  const w=Math.min(Math.max(val,0),100);
  const c=impactColor(val,area);
  return `<div class="bar-wrap" style="height:${h}px;position:relative;background:${thresholdTrackBg(area)};border-radius:6px;overflow:hidden">
    <div class="bar-fill" style="width:${w}%;height:100%;background:${c};box-shadow:0 0 8px ${c}88;border-radius:0 6px 6px 0;position:relative;z-index:2"></div>${thresholdMarks(area)}
  </div>`;
}

function ruleText(parts){return parts.map(([v,b,p])=>`${v}–${b}=${p>0?'+':''}${p}`).join(', ');}
function impactInfoText(r){
  r=r||SR;
  return `Impact je Rückläufer: NPS (${ruleText(r.rulesNPS)}) + CSAT (${ruleText(r.rulesCSAT)}). Maximal ${r.maxPos>=0?'+':''}${r.maxPos}, schlechtester Wert ${r.maxNeg}. Kritisch = NPS 0–6 oder CSAT 1–3.`;
}
function impactInfoHtml(){
  const txt=impactInfoText(SR);
  const areas=SR.area||{};
  const areaTxt=COLOR_AREAS.map(k=>`${k==='KDBS'?'KDB':k}: ${thresholdInfo(k)}`).join(' · ');
  return `<div class="impact-info"><b>Impact-Logik:</b> ${txt} <br><span class="pos">Ampel/Farben kommen aus „Einstellungen Impact“</span>${areaTxt?` · ${areaTxt}`:''}<br>Negative Werte laufen im Balken von rechts nach links und werden dunkler, je stärker der Minus-Impact ist.</div>`;
}
