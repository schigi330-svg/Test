function toNumber(v){
  if(v===null||v===undefined||v==='')return NaN;
  if(typeof v==='number')return v;
  if(v instanceof Date)return NaN;
  return Number(String(v).replace('%','').replace(',','.').trim());
}
function cloneRules(r){return JSON.parse(JSON.stringify(r));}
function parseDateValue(v){
  if(v===null||v===undefined||v==='')return null;
  if(v instanceof Date && !isNaN(v))return new Date(v.getFullYear(),v.getMonth(),v.getDate());
  if(typeof v==='number' && isFinite(v) && v>20000 && v<80000){
    const d=new Date(Math.round((v-25569)*86400*1000));
    return new Date(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate());
  }
  const s=String(v).trim();
  let m=s.match(/^(\d{1,2})[\.\/\-](\d{1,2})[\.\/\-](\d{2,4})/);
  if(m){let y=Number(m[3]); if(y<100)y+=2000; const d=new Date(y,Number(m[2])-1,Number(m[1])); return isNaN(d)?null:d;}
  m=s.match(/^(\d{4})[\-\/\.](\d{1,2})[\-\/\.](\d{1,2})/);
  if(m){const d=new Date(Number(m[1]),Number(m[2])-1,Number(m[3])); return isNaN(d)?null:d;}
  return null;
}
function fmtDateDE(d){if(!d)return 'unbekannt';try{return d.toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit',year:'numeric'});}catch(e){return 'unbekannt';}}
function standDate(){return fmtDateDE(AD?.daysInfo?.last || SR?.lastDate || null);}
function dkey(d){return d?`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`:'';}
function addDays(d,n){const x=new Date(d);x.setDate(x.getDate()+n);return x;}
function workdaysBetween(a,b,closures){
  if(!a||!b)return null; let s=a<=b?a:b, e=a<=b?b:a, c=0, close=new Set((closures||[]).map(dkey));
  for(let d=new Date(s);d<=e;d=addDays(d,1)){const wd=d.getDay(); if(wd!==0&&wd!==6&&!close.has(dkey(d)))c++;}
  return c;
}
function parseRuleText(txt,prefix){
  const out=[]; const t=String(txt||'').replace(/–|—/g,'-');
  const re=new RegExp(prefix+'\\s*(\\d+)\\s*(?:-\\s*(\\d+))?\\s*=\\s*([+\\-]?\\d+)','gi');
  let m; while((m=re.exec(t))){const a=Number(m[1]),b=Number(m[2]||m[1]),p=Number(m[3]); if(!isNaN(a)&&!isNaN(b)&&!isNaN(p))out.push([Math.min(a,b),Math.max(a,b),p]);}
  return out;
}
function normalizeRules(rs){return rs.filter(x=>x&&x.length>=3).map(([a,b,p])=>[Number(a),Number(b),Number(p)]).filter(x=>x.every(v=>!isNaN(v))).sort((a,b)=>b[0]-a[0]);}

