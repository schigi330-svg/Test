<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>XXXLutz CSAT Dashboard</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',Arial,sans-serif;background:#0d0f14;color:#fff;min-height:100vh}
html{background:#0d0f14}
button{font-family:inherit;cursor:pointer}
@media print{
  *{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;color-adjust:exact!important}
  html,body{margin:0!important;padding:0!important;background:#ffffff!important;color:#1a1a1a!important}
  .no-print{display:none!important}
  .print-page{display:none!important}
  .print-page.active-print{display:block!important;page-break-after:always;background:#ffffff!important;color:#1a1a1a!important}
  .print-a4{width:210mm!important;height:297mm!important;overflow:hidden!important;padding:6mm!important;background:#ffffff!important;color:#1a1a1a!important;position:relative!important}
  .print-a3{width:297mm!important;height:420mm!important;overflow:hidden!important;padding:6mm!important;background:#ffffff!important;color:#1a1a1a!important;position:relative!important}
}
.print-page{display:none}
.header{background:linear-gradient(180deg,#1a0000,#0d0f14);border-bottom:1px solid rgba(204,0,0,0.3);padding:0 28px}
.header-inner{max-width:1100px;margin:0 auto}
.logo-bar{display:flex;justify-content:space-between;align-items:center;padding:14px 0 10px}
.xxxl-logo-img{display:block;height:52px;width:auto;object-fit:contain;box-shadow:0 4px 16px rgba(0,0,0,.38);background:#fff}
.xxxl-left{display:flex;align-items:center;justify-content:center;background:#fff;color:#282a2f;padding:0 18px 0 19px;font-size:32px;min-width:122px;transform:scaleX(1.05);transform-origin:left center}
.xxxl-right{display:flex;align-items:center;justify-content:center;background:#E30613;padding:0 17px 0 14px;font-size:32px;min-width:118px}
.xxxl-l{color:#282a2f;margin-right:1px;letter-spacing:-2.6px}.xxxl-utz{color:#fff;letter-spacing:-3px;text-transform:none}
.logo-sub{border-left:1px solid rgba(255,255,255,0.15);padding-left:14px}
.logo-sub .s1{font-size:10px;color:rgba(255,255,255,0.4);letter-spacing:2px;text-transform:uppercase}
.logo-sub .s2{font-size:15px;font-weight:800;color:#fff}
.stat-bar{display:flex;gap:10px}
.stat-box{text-align:center;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);padding:8px 16px;border-radius:10px}
.stat-box .sv{font-size:20px;font-weight:900}
.stat-box .sl{font-size:10px;color:rgba(255,255,255,0.4);margin-top:1px}
.tabs{display:flex;gap:2px}
.tab{background:transparent;color:rgba(255,255,255,0.4);border:none;border-bottom:2px solid transparent;padding:10px 20px;font-weight:500;font-size:13px;transition:all .15s}
.tab.active{color:#fff;border-bottom-color:#CC0000;background:rgba(204,0,0,0.15)}
.content{max-width:1100px;margin:0 auto;padding:24px 20px}
.upload-zone{border:2px dashed rgba(204,0,0,.35);border-radius:16px;padding:20px;background:rgba(255,255,255,0.02);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;cursor:pointer;margin-bottom:18px;transition:all .25s;text-align:center}
.upload-zone:hover,.upload-zone.drag{border-color:#F5A800;background:rgba(245,168,0,0.08)}
.upload-btn{background:#CC0000;color:#fff;padding:8px 18px;border-radius:8px;font-weight:800;font-size:13px;border:none}
.scoring-badge{background:rgba(245,168,0,0.08);border:1px solid rgba(245,168,0,0.25);border-radius:10px;padding:10px 16px;font-size:12px;color:rgba(255,255,255,0.6);margin-bottom:18px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.scoring-badge b{color:#fff}
.ampel{padding:3px 12px;border-radius:20px;font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;display:inline-block}
.ag{background:#00a651;color:#fff}
.ay{background:#F5A800;color:#1a1a1a}
.ar{background:#CC0000;color:#fff}
.bar-wrap{background:rgba(255,255,255,0.1);border-radius:6px;overflow:hidden}
.bar-fill{border-radius:6px;transition:width .8s cubic-bezier(.4,0,.2,1)}
.top-card{background:linear-gradient(145deg,#2a1f00,#3d2e00,#1a1400);border:2px solid #F5A800;border-radius:20px;padding:28px;cursor:pointer;position:relative;overflow:hidden;box-shadow:0 0 40px rgba(245,168,0,0.35),0 8px 32px rgba(0,0,0,0.6);margin-bottom:14px}
.top-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,#F5A800,#fff8e1,#F5A800,transparent)}
.kdb-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.kdb-card{border-radius:16px;padding:20px 22px;cursor:pointer;box-shadow:0 4px 20px rgba(0,0,0,0.5)}
.sg{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;margin-top:14px}
.sc{text-align:center;background:rgba(255,255,255,0.06);border-radius:10px;padding:10px 4px;border:1px solid rgba(245,168,0,0.15)}
.sc .sv{font-size:20px;font-weight:900;color:#F5A800}
.sc .sl{font-size:11px;color:rgba(255,255,255,0.4);margin-top:2px}
.sg2{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:6px;margin-top:12px}
.sc2{text-align:center;background:rgba(255,255,255,0.05);border-radius:8px;padding:7px 4px}
.sc2 .sl{font-size:10px;color:rgba(255,255,255,0.35);margin-top:1px}
.tour-table{background:rgba(255,255,255,0.02);border-radius:14px;overflow-x:auto;overflow-y:hidden;border:1px solid rgba(255,255,255,0.07);-webkit-overflow-scrolling:touch}
.tour-table::-webkit-scrollbar{height:8px}.tour-table::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border-radius:8px}
.tour-header{display:grid;grid-template-columns:48px 70px minmax(190px,1fr) 120px 220px 110px;min-width:770px;gap:8px;padding:10px 16px;background:rgba(0,0,0,0.3);border-bottom:1px solid rgba(255,255,255,0.08);font-size:11px;font-weight:700;color:rgba(255,255,255,0.4);letter-spacing:1px;text-transform:uppercase}
.tour-row{display:grid;grid-template-columns:48px 70px minmax(190px,1fr) 120px 220px 110px;min-width:770px;gap:8px;padding:9px 16px;border-bottom:1px solid rgba(255,255,255,0.05);align-items:center}
.tour-row:nth-child(even){background:rgba(255,255,255,0.02)}
.bereich-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:20px}
.bereich-card{background:rgba(255,255,255,0.03);border-radius:14px;padding:20px;border:1px solid rgba(255,255,255,0.08)}
.footer{border-top:1px solid rgba(255,255,255,0.05);padding:14px 28px;margin-top:40px;display:flex;justify-content:space-between;font-size:11px;color:rgba(255,255,255,0.2)}
.ai-btn{background:rgba(255,255,255,0.05);color:rgba(255,255,255,0.6);border:1px solid rgba(255,255,255,0.1);padding:7px 16px;border-radius:10px;font-weight:700;font-size:13px;transition:all .2s}
.empty{text-align:center;padding:70px 20px;background:rgba(255,255,255,0.02);border-radius:16px;border:1px solid rgba(255,255,255,0.06)}
.print-bar-fixed{position:fixed;bottom:20px;right:20px;display:flex;flex-direction:column;gap:8px;z-index:100}
.pbf{background:#CC0000;color:#fff;border:none;padding:10px 18px;border-radius:10px;font-weight:800;font-size:13px;box-shadow:0 4px 20px rgba(204,0,0,0.5)}
.pbf.a3{background:#1a1a1a;border:1px solid #F5A800;color:#F5A800}
/* PRINT */
.print-a4{width:210mm;min-height:297mm;overflow:visible;background:#ffffff;color:#1a1a1a;padding:8mm;font-family:'Segoe UI',Arial,sans-serif;position:relative}
.print-a3{width:420mm;min-height:297mm;overflow:visible;background:#ffffff;color:#1a1a1a;padding:8mm;font-family:'Segoe UI',Arial,sans-serif;font-size:10px;position:relative}
.ph{background:#CC0000;color:#fff;padding:10px 16px;border-radius:8px;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.ph .plogo-img{display:block;width:64mm;height:auto;max-height:20mm;object-fit:contain;background:#fff}
.ph .plogo .xxxl-left{}
.ph .plogo .xxxl-right{}
.ph .plogo .xxxl-l{}.ph .plogo .xxxl-utz{}
.ph .ptitle{font-size:13px;font-weight:700}
.ph .pdate{font-size:11px;opacity:0.8}
.psec{font-size:13px;font-weight:800;color:#CC0000;margin:12px 0 8px;border-bottom:2px solid #CC0000;padding-bottom:4px}
.pkdb{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:8px;margin-bottom:7px}
.pbar-wrap{background:#e9ecef;border-radius:4px;height:10px;margin:5px 0;overflow:hidden;flex:1}
.pbar{height:100%;border-radius:4px}
.pt{width:100%;border-collapse:collapse;font-size:10px}
.pt th{background:#CC0000;color:#fff;padding:5px 7px;text-align:left;font-weight:700}
.pt td{padding:4px 7px;border-bottom:1px solid #dee2e6}
.pt tr:nth-child(even) td{background:#f8f9fa}
.pag{background:#00a651;color:#fff;padding:1px 7px;border-radius:10px;font-size:9px;font-weight:700}
.pay{background:#F5A800;color:#1a1a1a;padding:1px 7px;border-radius:10px;font-size:9px;font-weight:700}
.par{background:#CC0000;color:#fff;padding:1px 7px;border-radius:10px;font-size:9px;font-weight:700}
.pfooter{margin-top:10px;padding-top:8px;border-top:1px solid #dee2e6;font-size:9px;color:#888;display:flex;justify-content:space-between}

.impact-info{background:rgba(245,168,0,.08);border:1px solid rgba(245,168,0,.22);border-radius:10px;padding:10px 14px;margin:12px 0 16px;font-size:12px;line-height:1.55;color:rgba(255,255,255,.72)}
.impact-info b{color:#fff}.impact-info .pos{color:#00d46a;font-weight:800}.impact-info .neg{color:#ff6b6b;font-weight:800}
.pinfo{background:#fff8e1;border:1px solid #f5c542;border-radius:6px;padding:5px 7px;margin:5px 0 6px;font-size:7.8px;color:#333;line-height:1.28}
.print-a4 .ph{padding:7px 11px;margin-bottom:7px}.print-a4 .psec{font-size:11px;margin:7px 0 4px}.print-a4 .pt{font-size:7.9px}.print-a4 .pt th{padding:3px 4px}.print-a4 .pt td{padding:2.4px 4px}.print-a4 .pfooter{font-size:8px;margin-top:6px}.print-a4 .pag,.print-a4 .pay,.print-a4 .par{font-size:7.5px;padding:1px 5px}

@media (min-width:900px){
  .content{max-width:1180px}
  #t-touren .top-card{padding:32px}
}
@media (max-width:650px){
  .content{padding:18px 14px}
  .tour-table{margin-left:-2px;margin-right:-2px}
}

@keyframes floatUp{0%,100%{transform:translateY(0) rotate(-2deg) scale(1);}50%{transform:translateY(-10px) rotate(2deg) scale(1.12);}}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.7;}}
#uz-icon{animation:floatUp 2.2s ease-in-out infinite;display:inline-block;font-size:52px;line-height:1;cursor:pointer}
.upload-zone.drag #uz-icon{animation:floatUp .35s ease-in-out infinite;font-size:62px;}

</style>
</head>
<body>

<div id="dashboard" class="no-print">
  <div class="header">
    <div class="header-inner">
      <div class="logo-bar">
        <div style="display:flex;align-items:center;gap:14px">
          <img class="xxxl-logo-img" src="data:image/jpeg;base64," alt="XXXLutz Logo">
          <div class="logo-sub">
            <div class="s1">Kundenzufriedenheit</div>
            <div class="s2">CSAT · NPS · Impact Dashboard</div>
          </div>
        </div>
        <div class="stat-bar" id="statBar" style="display:none">
          <div class="stat-box"><div class="sv" id="gR">–</div><div class="sl">Rückläufer</div></div>
          <div class="stat-box"><div class="sv" id="gI">–</div><div class="sl">Ges. Impact</div></div>
          <div class="stat-box"><div class="sv" id="gN">–</div><div class="sl">NPS Ø</div></div>
          <div class="stat-box"><div class="sv" id="gK">–</div><div class="sl">Kritisch</div></div>
          <div class="stat-box"><div class="sv" id="gC">–</div><div class="sl">CSAT %</div></div>
        </div>
      </div>
      <div class="tabs">
        <button class="tab active" onclick="showTab('kdb',this)">🏆 KDB-Ranking</button>
        <button class="tab" onclick="showTab('touren',this)">🚚 Touren</button>
        <button class="tab" onclick="showTab('bereiche',this)">📊 Bereiche</button>
        <button class="tab" onclick="showTab('analyse',this)">🤖 KI-Analyse</button>
        <button class="tab" onclick="showTab('farben',this)">🎨 Farb-Einstellung</button>
        <button class="tab" onclick="showTab('einstellungen',this)">⚙️ Einstellungen</button>
      </div>
    </div>
  </div>
  <div class="content">
    <div class="upload-zone" id="uz" onclick="document.getElementById('fi').click()"
         ondragover="event.preventDefault();this.classList.add('drag')"
         ondragleave="this.classList.remove('drag')"
         ondrop="event.preventDefault();this.classList.remove('drag');hf(event.dataTransfer.files[0])">
      <div id="uz-icon">📥</div>
      <div style="font-size:13px;font-weight:700;color:rgba(255,255,255,.75);margin-top:6px">Datei ablegen</div>
      <div style="font-size:11px;color:rgba(255,255,255,.3);margin-top:2px">Excel · CSV · TXT</div>
      <div style="font-size:11px;color:#00a651;font-weight:600;min-height:15px;margin-top:3px" id="us"></div>
      <input type="file" id="fi" accept=".xlsx,.xls,.csv,.txt" style="display:none" onchange="hf(this.files[0])">
    </div>
    <div class="scoring-badge" id="sb">
      <b>📋 Aktuelle Punktwerte:</b>
      <span id="st">NPS: 9–10=<b>+2</b>, 7–8=<b>+1</b>, 4–6=<b>-1</b>, 0–3=<b>-2</b> | CSAT: 5=<b>+2</b>, 4=<b>+1</b>, 1–3=<b>-4</b> | Max: <b style="color:#00a651">+4</b> / <b style="color:#CC0000">-6</b></span>
    </div>
    <div id="t-kdb"></div>
    <div id="t-touren" style="display:none"></div>
    <div id="t-bereiche" style="display:none"></div>
    <div id="t-analyse" style="display:none"></div>
    <div id="t-farben" style="display:none"></div>
    <div id="t-einstellungen" style="display:none"></div>
  </div>
  <div class="footer no-print">
    <span>XXXLutz CSAT Dashboard · SC-LU Würselen</span>
  </div>
</div>

<div class="print-bar-fixed no-print" id="pb" style="display:none">
  <button class="pbf" onclick="doPrint('m')">🖨️ Möbel A4</button>
  <button class="pbf" onclick="doPrint('s')">🖨️ Liefertour A4</button>
  <button class="pbf a3" onclick="doPrint('k')">🖨️ Küche A3 Hochformat</button>
  <button class="pbf" style="background:#1f2937;border:1px solid rgba(255,255,255,.18)" onclick="doPrint('kdb')">🖨️ KDB extra</button>
</div>

<div id="pM" class="print-page"></div>
<div id="pS" class="print-page"></div>
<div id="pK" class="print-page"></div>
<div id="pKDB" class="print-page"></div>

