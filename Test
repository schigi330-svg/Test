  SR.rulesNPS=newNPS;
  SR.rulesCSAT=newCSAT;
  SR.maxPos=Math.max(...newNPS.map(x=>x[2]).filter(x=>x>0),0)+Math.max(...newCSAT.map(x=>x[2]).filter(x=>x>0),0);
  SR.maxNeg=Math.min(...newNPS.map(x=>x[2]).filter(x=>x<0),0)+Math.min(...newCSAT.map(x=>x[2]).filter(x=>x<0),0);
