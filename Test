}

function psr(wb){
  const base=cloneRules(SR); const sh=wb.Sheets['Einstellungen Impact']; if(!sh)return base;
  const rows=sheetRows(sh,false);
  let rN=[],rC=[],mp=base.maxPos,mn=base.maxNeg;
  const allText=[];
  for(const row of rows){
    allText.push(row.map(v=>String(v??'')).join(' '));
    const cat=String(row[0]||'').trim(); const v=toNumber(row[1]), b=toNumber(row[2]), p=toNumber(row[3]);
    if(cat==='NPS'&&!isNaN(v)&&!isNaN(p))rN.push([v,isNaN(b)?v:b,p]);
    if(cat==='CSAT'&&!isNaN(v)&&!isNaN(p))rC.push([v,isNaN(b)?v:b,p]);
    const label=String(row[0]||'')+' '+String(row[3]||'')+' '+String(row[4]||'');
    if(label.includes('Maximal positiv')){const nums=row.map(toNumber).filter(x=>!isNaN(x)); if(nums.length)mp=nums[nums.length-1];}
    if(label.includes('Maximal negativ')){const nums=row.map(toNumber).filter(x=>!isNaN(x)); if(nums.length)mn=nums[nums.length-1];}
  }
  const text=allText.join(' | ');
  if(!rN.length){rN=parseRuleText(text,'NPS');}
  if(!rC.length){rC=parseRuleText(text,'CSAT');}
  base.rulesNPS=normalizeRules(rN.length?rN:base.rulesNPS);
  base.rulesCSAT=normalizeRules(rC.length?rC:base.rulesCSAT);
  base.maxPos=Math.max(...base.rulesNPS.map(x=>x[2]).filter(x=>x>0),0)+Math.max(...base.rulesCSAT.map(x=>x[2]).filter(x=>x>0),0);
  base.maxNeg=Math.min(...base.rulesNPS.map(x=>x[2]).filter(x=>x<0),0)+Math.min(...base.rulesCSAT.map(x=>x[2]).filter(x=>x<0),0);
  const areaNames=['KDBS','Liefertour','Möbel','Küche','Kundendienst'];
  base.area=base.area||{};
  for(const row of rows){
    const name=String(row[0]||'').trim(); if(!areaNames.includes(name))continue;
    const kd=toNumber(row[7]), gp=toNumber(row[8]), yp=toNumber(row[9]);
    const manualG=toNumber(row[15]), manualY=toNumber(row[16]);
    base.area[name]=Object.assign({},base.area[name]||{},{});
    if(!isNaN(kd)&&kd>0)base.area[name].kd=kd;
    if(!isNaN(gp)&&gp>0)base.area[name].greenPct=gp>1?gp/100:gp;
    if(!isNaN(yp)&&yp>0)base.area[name].yellowPct=yp>1?yp/100:yp;
    if(!isNaN(manualG))base.area[name].manualGreen=manualG;
    if(!isNaN(manualY))base.area[name].manualYellow=manualY;
  }
  for(const row of rows){
    const a=String(row[0]||'').toLowerCase();
    if(a.includes('manuelle arbeitstage')){const n=toNumber(row[1]); if(!isNaN(n)&&n>0)base.manualDays=Math.round(n);}
    if(a.includes('manuelles enddatum')){const d=parseDateValue(row[1]); if(d)base.manualEnd=d;}
  }
  let closeMode=false;
  for(const row of rows){
    const text=row.map(v=>String(v??'')).join(' ').toLowerCase();
    if(text.includes('feiertage')||text.includes('schließtage')){closeMode=true; continue;}
    if(closeMode){for(const cell of row){const d=parseDateValue(cell); if(d)base.closures.push(d);}}
  }
  return base;
}

