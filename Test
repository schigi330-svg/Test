function runA(code){
  if(!AD)return; SK=code; rAnalyse();
  const k=AD.kdbs.find(x=>x.kdb===code); if(!k)return;
  const ri=AD.kdbs.findIndex(x=>x.kdb===code),rc=RC[ri]||'#94a3b8';
  const tor=AD.touren.filter(t=>t.kdb===code&&t.hatBewertungen);
  const worst=[...tor].sort((a,b)=>a.impactPct-b.impactPct).slice(0,3);
  const best=[...tor].sort((a,b)=>b.impactPct-a.impactPct).slice(0,3);
  const status=k.impactPct>=77.5?'stark auf Kurs':k.impactPct>=60?'im mittleren Bereich':'unter Ziel';
  const action=worst.length?`Sofort anschauen: ${worst.map(t=>`${t.tour} (${t.bereich}, ${t.impactPct.toFixed(0)}%)`).join(', ')}.`:'Aktuell keine bewerteten Touren mit Auffälligkeit.';
