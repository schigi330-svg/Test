async function inflateRawLite(u8){
  if(typeof DecompressionStream==='undefined')throw new Error('Offline-XLSX wird von diesem Browser nicht unterstützt. Bitte Chrome/Edge nutzen.');
  const ds=new DecompressionStream('deflate-raw');
  const stream=new Blob([u8]).stream().pipeThrough(ds);
  return new Uint8Array(await new Response(stream).arrayBuffer());
}
function zU16(d,o){return d[o]|(d[o+1]<<8);}
function zU32(d,o){return (d[o]|(d[o+1]<<8)|(d[o+2]<<16)|(d[o+3]<<24))>>>0;}
async function unzipLite(buf){
  const data=new Uint8Array(buf), dec=new TextDecoder('utf-8');
  let eocd=-1;
  for(let i=data.length-22;i>=Math.max(0,data.length-66000);i--){if(zU32(data,i)===0x06054b50){eocd=i;break;}}
  if(eocd<0)throw new Error('XLSX-ZIP konnte nicht gelesen werden.');
  const total=zU16(data,eocd+10), cdOff=zU32(data,eocd+16), files={};
  let p=cdOff;
  for(let i=0;i<total;i++){
    if(zU32(data,p)!==0x02014b50)break;
    const method=zU16(data,p+10), csize=zU32(data,p+20), nlen=zU16(data,p+28), xlen=zU16(data,p+30), clen=zU16(data,p+32), loff=zU32(data,p+42);
    const name=dec.decode(data.slice(p+46,p+46+nlen));
    const lnlen=zU16(data,loff+26), lxlen=zU16(data,loff+28), start=loff+30+lnlen+lxlen;
    const comp=data.slice(start,start+csize);
    let out;
    if(method===0)out=comp;
    else if(method===8)out=await inflateRawLite(comp);
    else throw new Error('ZIP-Kompression nicht unterstützt: '+method);
    files[name]=dec.decode(out);
    p+=46+nlen+xlen+clen;
  }
  return files;
}
function xmlLite(txt){return new DOMParser().parseFromString(txt,'application/xml');}
function textLite(node){
  if(!node)return '';
  return Array.from(node.getElementsByTagName('t')).map(t=>t.textContent||'').join('');
}
function colIndexLite(ref){
  const m=String(ref||'A').match(/[A-Z]+/i);
  if(!m)return 0;
  let n=0;
  for(const ch of m[0].toUpperCase())n=n*26+(ch.charCodeAt(0)-64);
  return n-1;
}
function readSharedLite(files){
  const xml=files['xl/sharedStrings.xml'];
  if(!xml)return [];
  const doc=xmlLite(xml);
  return Array.from(doc.getElementsByTagName('si')).map(si=>textLite(si));
}
function readSheetRowsLite(xml, shared){
  const doc=xmlLite(xml);
  const rows=[];
  Array.from(doc.getElementsByTagName('row')).forEach(row=>{
    const out=[];
    Array.from(row.getElementsByTagName('c')).forEach(c=>{
      const idx=colIndexLite(c.getAttribute('r')||'A');
      const t=c.getAttribute('t')||'';
      let val=null;
      if(t==='inlineStr')val=textLite(c);
      else{
        const v=c.getElementsByTagName('v')[0];
        if(v){
          const raw=v.textContent;
          if(t==='s')val=shared[Number(raw)]??'';
          else if(t==='b')val=raw==='1';
          else if(t==='str')val=raw;
          else {
            const num=Number(raw);
            val=isNaN(num)?raw:num;
          }
        }
      }
      out[idx]=val;
    });
    rows.push(out);
  });
  return rows;
}
async function readXlsxLite(buf){
  const files=await unzipLite(buf);
  const wbXml=files['xl/workbook.xml'];
  const relXml=files['xl/_rels/workbook.xml.rels'];
  if(!wbXml||!relXml)throw new Error('XLSX enthält keine Arbeitsmappe.');
  const wbDoc=xmlLite(wbXml), relDoc=xmlLite(relXml);
  const rels={};
  Array.from(relDoc.getElementsByTagName('Relationship')).forEach(r=>{
    let target=r.getAttribute('Target')||'';
    if(target.startsWith('/'))target=target.slice(1);
    else target='xl/'+target.replace(/^\/+/,'');
    target=target.replace(/\/\.\//g,'/');
    rels[r.getAttribute('Id')]=target;
  });
  const shared=readSharedLite(files);
  const Sheets={}, SheetNames=[];
  Array.from(wbDoc.getElementsByTagName('sheet')).forEach(s=>{
    const name=s.getAttribute('name');
    const rid=s.getAttribute('r:id')||s.getAttribute('id');
    const path=rels[rid];
    if(name&&path&&files[path]){
      SheetNames.push(name);
      Sheets[name]={__rows:readSheetRowsLite(files[path],shared)};
    }
  });
  return {SheetNames, Sheets, __lite:true};
}
async function readWorkbookAny(buf){
  if(window.XLSX && XLSX.read){
    try{return XLSX.read(buf,{type:'array',cellDates:true});}
    catch(e){console.warn('SheetJS konnte die Datei nicht lesen, Offline-Fallback wird versucht.',e);}
  }
  return await readXlsxLite(buf);
}

function hf(file){
  if(!file)return;
  const name=(file.name||'Datei').toLowerCase();
  const isText=name.endsWith('.txt')||name.endsWith('.csv')||file.type.startsWith('text/');
  const reader=new FileReader();
  reader.onerror=()=>alert('Datei konnte nicht gelesen werden.');
  if(isText){
    reader.onload=e=>{
      try{
        const r=SR;
        const records=recordsFromText(e.target.result,r);
        applyData(records,TM,BM,KTA,KN,r,file.name||'Textdatei');
      }catch(err){
        console.error(err);
        alert('Die Textdatei konnte nicht ausgewertet werden. Bitte prüfen: Spalten NPS, CSAT und Tour müssen vorhanden sein.');
      }
    };
    reader.readAsText(file,'utf-8');
  }else{
    reader.onload=async e=>{
      try{
        const wb=await readWorkbookAny(e.target.result);
        const r=psr(wb)||SR;
        const{tourMap,bereichMap,kdbTourenAlle,kdbNames}=ptm(wb);
        const records=prd(wb,r);
        applyData(records,tourMap,bereichMap,kdbTourenAlle,kdbNames,r,file.name||'Excel-Datei');
      }catch(err){
        console.error(err);
        alert('Die Datei konnte nicht ausgewertet werden. Bitte diese Punkte prüfen: 1) Chrome/Edge nutzen, 2) Excel-Datei darf nicht passwortgeschützt sein, 3) Blatt "ROHDATEN HIER EINFÜGEN" braucht NPS, CSAT und Tour. Fehler: '+(err&&err.message?err.message:err));
      }
    };
    reader.readAsArrayBuffer(file);
  }
}

