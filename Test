function negImpactWidth(impact){
  const worst=Math.max(1,Math.abs((SR&&SR.maxNeg)||-6));
  return Math.min(100,Math.abs(Number(impact)||0)/worst*100);
}

function impactColorByValue(impact,pct,area){
  const im=Number(impact)||0;
  if(im<0)return negRed(negImpactWidth(im));
  return impactColor(Number(pct)||0,area);
}

function tourPillStyle(impact,pct,area){
  const c=impactColorByValue(impact,pct,area);
  const bg=(Number(impact)||0)<0?`${c}42`:`${c}2f`;
  return `background:${bg};border:1px solid ${c}80;color:${c};`;
}
function tourSortValue(t){
  if(t && t.hatBewertungen && (Number(t.impact)||0)<0)return 2;  // Negativ immer ganz unten
  if(!t || !t.hatBewertungen)return 1;                            // keine Bewertungen in die Mitte
  return 0;                                                        // positive/0 zuerst
}
function sortToursForRanking(a,b){
  const ga=tourSortValue(a), gb=tourSortValue(b);
  if(ga!==gb)return ga-gb;
  if(ga===0)return (Number(b.impact)||0)-(Number(a.impact)||0);
  if(ga===2)return (Number(b.impact)||0)-(Number(a.impact)||0);    // -1 vor -6
  return String(a.tour||'').localeCompare(String(b.tour||''),'de');
}


