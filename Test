function findHeaderRow(rows){
  for(let i=0;i<Math.min(rows.length,80);i++){
    const line=rows[i].map(v=>String(v||'').toLowerCase());
    if(line.some(v=>v.includes('nps')) && line.some(v=>v.includes('csat')) && line.some(v=>v.trim()==='tour' || v.includes('tour'))) return i;
  }
  return -1;
}

function normalizeHeader(h){return String(h||'').toLowerCase().replace(/\s+/g,' ').trim();}


function cleanCommentText(v){
  const s=String(v??'').replace(/<[^>]*>/g,' ').replace(/&nbsp;/gi,' ').replace(/\s+/g,' ').trim();
  if(!s || s==='-' || s==='/' || /^k\.?\s*a\.?$/i.test(s) || /^keine?\s+(angabe|kommentar)/i.test(s))return '';
  return s;
}
function escHtml(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function shortenText(v,max){
  const s=cleanCommentText(v); if(!s)return '';
  const n=max||260; return s.length>n?s.slice(0,n-1).trim()+'…':s;
}

function isLikelyCommentHeader(h){
  h=normalizeHeader(h);
  return ['kommentar','comment','feedback','bemerkung','kundenmeinung','bewertungstext','grund','antwort','anmerkung','notiz','freitext','frei text','beschreibung','erlaeuterung','erläuterung','hinweis','lob','kritik','gefallen','zufrieden','message','text','kundentext','kunden text','antworttext','antwort text','open end','offene antwort'].some(k=>h.includes(k));
}
function isCommentLikeText(s){
  s=cleanCommentText(s);
  if(!s || s.length<8)return false;
  if(/^\d+([,.]\d+)?$/.test(s))return false;
  if(/^O\d{2}$/i.test(s))return false;
  if(/^\d{1,2}\.\d{1,2}\.\d{2,4}$/.test(s))return false;
  if(/^\d{4}-\d{2}-\d{2}$/.test(s))return false;
  const letters=(s.match(/[A-Za-zÄÖÜäöüß]/g)||[]).length;
  if(letters<5)return false;
  // Kommentare haben meist Leerzeichen/Satzzeichen; einzelne Namen/IDs werden dadurch eher rausgefiltert
  return /[\s.,;:!?\-]/.test(s) || s.length>22;
}
function pickRowComment(row,cols,exclude){
  const skip=new Set([exclude.nc,exclude.cc,exclude.tc,exclude.dc].filter(i=>i!==undefined&&i>=0));
  const found=[];
  for(const i of (cols||[])){
    if(skip.has(i))continue;
    const s=cleanCommentText(row[i]);
    if(isCommentLikeText(s))found.push(s);
  }
  if(found.length)return found.sort((a,b)=>b.length-a.length)[0];
  // Fallback: falls die Überschrift unbekannt ist, alle freien Textfelder prüfen
  const fallback=[];
  for(let i=0;i<row.length;i++){
    if(skip.has(i))continue;
    const s=cleanCommentText(row[i]);
    if(isCommentLikeText(s) && !/^([A-Z0-9]{3,}|KN4|2N7B|2TPX|3QJQ|467J)$/i.test(s))fallback.push(s);
  }
  return fallback.length?fallback.sort((a,b)=>b.length-a.length)[0]:'';
}

function pickPositiveComment(list){
  const arr=(list||[]).filter(c=>c&&cleanCommentText(c.text));
  if(!arr.length)return null;
  arr.sort((a,b)=>(Number(b.csat)||0)-(Number(a.csat)||0)||(Number(b.nps)||0)-(Number(a.nps)||0)||(Number(b.impact)||0)-(Number(a.impact)||0)||cleanCommentText(b.text).length-cleanCommentText(a.text).length);
  return arr[0];
}
function areaPositiveComment(areaTours){
  const green=(areaTours||[]).filter(t=>t&&t.hatBewertungen&&(Number(t.impactPct)||0)>=77.5).slice().sort(sortToursForRanking);
  for(const t of green){
    const c=pickPositiveComment(t.comments||[]);
    if(c)return {tour:t.tour,comment:c,impactPct:Number(t.impactPct)||0,impact:Number(t.impact)||0};
  }
  return null;
}
function printPositiveCommentBox(item,isA3){
  if(!item||!item.comment)return '';
  const txt=shortenText(item.comment.text,isA3?330:230);
  if(!txt)return '';
  const meta=[];
  if(item.comment.csat!==undefined)meta.push('CSAT '+item.comment.csat);
  if(item.comment.nps!==undefined)meta.push('NPS '+item.comment.nps);
  if(item.comment.date)meta.push(fmtDateDE(item.comment.date));
  return `<div style="background:linear-gradient(135deg,rgba(0,166,81,.16),rgba(0,166,81,.055));border:1px solid rgba(0,166,81,.42);border-left:5px solid #00c875;border-radius:12px;padding:${isA3?'7px 11px':'6px 9px'};margin-bottom:7px;color:#fff;line-height:1.35">
    <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:3px">
      <div style="font-size:${isA3?'9.5px':'8.2px'};font-weight:950;color:#00c875;letter-spacing:.3px;text-transform:uppercase">Positiver CSAT-Kommentar · beste grüne Tour ${escHtml(item.tour)}</div>
      <div style="font-size:${isA3?'8.2px':'7px'};color:rgba(255,255,255,.58);white-space:nowrap">${escHtml(meta.join(' · '))}</div>
    </div>
    <div style="font-size:${isA3?'11px':'9px'};font-weight:700;color:rgba(255,255,255,.92);font-style:italic">„${escHtml(txt)}“</div>
  </div>`;
}

function recordsFromRows(rows,r){
  const hi=findHeaderRow(rows); if(hi===-1)return null;
  const hd=rows[hi].map(normalizeHeader);
  const nc=hd.findIndex(h=>h.includes('nps'));
  const cc=hd.findIndex(h=>h.includes('csat'));
  const tc=hd.findIndex(h=>h==='tour' || h.endsWith(' tour') || h.includes('tour'));
  const dc=hd.findIndex(h=>h.includes('datum fragebogen')||h.includes('bewertungsdatum')||h==='datum'||h.includes('datum'));
  const commentCols=hd.map((h,i)=>isLikelyCommentHeader(h)?i:-1).filter(i=>i>=0);
  if(nc<0||cc<0||tc<0)return null;
  const rec=[];
  for(let i=hi+1;i<rows.length;i++){
    const row=rows[i];
    const npsRaw=String(row[nc]??'').replace(',','.').trim();
    const csatRaw=String(row[cc]??'').replace(',','.').trim();
    const nps=Number(npsRaw), csat=Number(csatRaw);
    const tour=String(row[tc]??'').trim().toUpperCase();
    const date=dc>=0?parseDateValue(row[dc]):null;
    const comment=pickRowComment(row,commentCols,{nc,cc,tc,dc});
    if(isNaN(nps)||nps<0||nps>10||isNaN(csat)||csat<1||csat>5||tour.length<1)continue;
    rec.push({nps,csat,tour,date,comment,impact:ci(nps,csat,r),krit:nps<=3?1:0});
  }
  return rec;
}

function prd(wb,r){
  const wanted=['ROHDATEN HIER EINFÜGEN','Rohdaten','ROHDATEN','Daten'];
  for(const name of wanted){
    const sh=wb.Sheets[name];
    if(sh){
      const rows=sheetRows(sh,true);
      const rec=recordsFromRows(rows,r);
      if(rec&&rec.length)return rec;
    }
  }
  for(const name of wb.SheetNames||[]){
    const rows=sheetRows(wb.Sheets[name],true);
    const rec=recordsFromRows(rows,r);
    if(rec&&rec.length)return rec;
  }
  return null;
}

function splitTextRows(txt){
  const lines=String(txt||'').replace(/^\uFEFF/,'').split(/\r?\n/).filter(l=>l.trim().length>0);
  if(!lines.length)return [];
  const sample=lines.slice(0,10).join('\n');
  const candidates=['\t',';',','];
  let delim='\t',best=-1;
  for(const d of candidates){
    const score=(sample.match(new RegExp(d==='\t'?'\\t':d,'g'))||[]).length;
    if(score>best){best=score;delim=d;}
  }
  return lines.map(line=>{
    if(delim===','){
      const out=[]; let cur='',q=false;
      for(let i=0;i<line.length;i++){
        const ch=line[i];
        if(ch==='"'){q=!q; continue;}
        if(ch===','&&!q){out.push(cur);cur='';} else cur+=ch;
      }
      out.push(cur); return out.map(x=>x.trim());
    }
    return line.split(delim).map(x=>String(x).trim().replace(/^"|"$/g,''));
  });
}

function recordsFromText(txt,r){
  const rows=splitTextRows(txt);
  return recordsFromRows(rows,r);
}


function detectDays(records,rules){
  const ds=records.map(x=>x.date).filter(Boolean).sort((a,b)=>a-b);
  let first=ds[0]||null, last=ds[ds.length-1]||null;
  let auto=first&&last?workdaysBetween(first,last,rules.closures||[]):null;
  let used=rules.manualDays||null;
  if(!used && rules.manualEnd && first)used=workdaysBetween(first,rules.manualEnd,rules.closures||[]);
  if(!used)used=auto||Math.max(1,new Set(ds.map(dkey)).size)||1;
  return {first,last,autoDays:auto,usedDays:Math.max(1,Math.round(used))};
}
function areaTarget(area,days,rules){
  const cfg=(rules.area&&rules.area[area])||rules.area?.['Küche']||{kd:1,greenPct:.775,yellowPct:.6};
  const max=Math.round(days*(cfg.kd||1)*(rules.maxPos||4));
  const green=(cfg.manualGreen!==undefined&&!isNaN(cfg.manualGreen))?Number(cfg.manualGreen):Math.ceil(max*(cfg.greenPct||.775));
  const yellow=(cfg.manualYellow!==undefined&&!isNaN(cfg.manualYellow))?Number(cfg.manualYellow):Math.ceil(max*(cfg.yellowPct||.6));
  return {max,green,yellow,kd:cfg.kd||1,greenPct:cfg.greenPct||.775,yellowPct:cfg.yellowPct||.6};
}
function combineTargets(ts){return ts.reduce((a,t)=>({max:a.max+t.max,green:a.green+t.green,yellow:a.yellow+t.yellow}),{max:0,green:0,yellow:0});}
function targetScorePct(impact,t){return t&&t.max>0?Math.max(0,(impact/t.max)*100):0;}
function calc(records,tourMap,bereichMap,kdbTourenAlle,kdbNamesTab,rules){
  const daysInfo=detectDays(records,rules); rules.usedDays=daysInfo.usedDays; rules.firstDate=daysInfo.first; rules.lastDate=daysInfo.last;
  const mp=rules.maxPos,aK=Object.keys(kdbTourenAlle);
  const ka={},ta={};
  for(const k of aK)ka[k]={rueckl:0,impact:0,npsSum:0,csatOk:0,krit:0,neg:0,tours:new Set(),tg:kdbTourenAlle[k]||[]};
  for(const r of records){
    const k=tourMap[r.tour]||'Unzugeordnet',b=bereichMap[r.tour]||'Unbekannt';
    if(!ka[k])ka[k]={rueckl:0,impact:0,npsSum:0,csatOk:0,krit:0,neg:0,tours:new Set(),tg:[]};
    const a=ka[k],ri=ci(r.nps,r.csat,rules);a.rueckl++;a.impact+=ri;a.npsSum+=r.nps;a.csatOk+=r.csat>=4?1:0;a.krit+=r.nps<=3?1:0;a.neg+=(ri<0?1:0);a.tours.add(r.tour);
    if(!ta[r.tour])ta[r.tour]={tour:r.tour,kdb:k,bereich:b,rueckl:0,impact:0,npsSum:0,csatOk:0,krit:0,neg:0,comments:[]};
    const t=ta[r.tour],ti=ci(r.nps,r.csat,rules);t.rueckl++;t.impact+=ti;t.npsSum+=r.nps;t.csatOk+=r.csat>=4?1:0;t.krit+=r.nps<=3?1:0;t.neg+=(ti<0?1:0);if(r.comment&&r.csat>=4)t.comments.push({text:r.comment,csat:r.csat,nps:r.nps,date:r.date,impact:r.impact});
  }
  const targetForTour=tour=>areaTarget(bereichMap[tour]||'Unbekannt',daysInfo.usedDays,rules);
  const kdbs=aK.filter(k=>k!=='Unzugeordnet').map(k=>{
    const a=ka[k];if(!a)return null;
    const kTargets=(kdbTourenAlle[k]||[]).map(targetForTour); const kt=combineTargets(kTargets); const tcnt=(kdbTourenAlle[k]||[]).length;
    return{kdb:k,name:kdbNamesTab[k]||KN[k]||k,rueckl:a.rueckl,impact:a.impact,neg:a.neg,maxImpact:kt.max,greenAb:kt.green,yellowAb:kt.yellow,
      nps:a.rueckl>0?a.npsSum/a.rueckl:0,csat:a.rueckl>0?a.csatOk/a.rueckl:0,
      krit:a.krit,kritPct:a.rueckl>0?a.krit/a.rueckl:0,
      impactPct:targetScorePct(a.impact,kt),it:tcnt>0?a.impact/tcnt:0,
      tourCountMitBew:a.tours.size,tourCountGesamt:tcnt};
  }).filter(Boolean).sort((a,b)=>(b.it-a.it)||(b.impact-a.impact));
  const at=[];
  for(const k of aK){
    for(const tour of(kdbTourenAlle[k]||[])){
      const agg=ta[tour],b=bereichMap[tour]||'Unbekannt', tg=targetForTour(tour);
      if(agg)at.push({...agg,maxImpact:tg.max,greenAb:tg.green,yellowAb:tg.yellow,nps:agg.rueckl>0?agg.npsSum/agg.rueckl:0,
        csat:agg.rueckl>0?agg.csatOk/agg.rueckl:0,kritPct:agg.rueckl>0?agg.krit/agg.rueckl:0,
        impactPct:targetScorePct(agg.impact,tg),comments:agg.comments||[],bestComment:pickPositiveComment(agg.comments),hatBewertungen:true});
      else at.push({tour,kdb:k,bereich:b,rueckl:0,impact:0,npsSum:0,csatOk:0,krit:0,neg:0,maxImpact:tg.max,greenAb:tg.green,yellowAb:tg.yellow,nps:0,csat:0,kritPct:0,impactPct:0,comments:[],bestComment:null,hatBewertungen:false});
    }
  }
  // Platz-1-Logik: pro Bereich maximalen Impact finden
  const bereichMax={};
  at.forEach(t=>{
    if(!t.hatBewertungen||!t.impact)return;
    if(bereichMax[t.bereich]===undefined||t.impact>bereichMax[t.bereich])
      bereichMax[t.bereich]=t.impact;
  });
  // impactPct relativ zu Platz 1 desselben Bereichs
  at.forEach(t=>{
    const bm=bereichMax[t.bereich]||1;
    if(t.hatBewertungen&&bm>0)t.impactPct=Math.max(0,(t.impact/bm)*100);
    else t.impactPct=0;
  });
  // KDB-Impact nach höchster Summe an Bewertungen:
  // Der KDB mit den meisten Rückläufern gibt den Max-Impact für alle KDBs vor.
  const kdbMaxRueckl=kdbs.reduce((m,k)=>Math.max(m,Number(k.rueckl)||0),0);
  const kdbBaseMax=kdbMaxRueckl>0?Math.max(1,kdbMaxRueckl*(rules.maxPos||4)):0;
  kdbs.forEach(k=>{
    k.maxImpact=kdbBaseMax;
    k.kdbMaxRueckl=kdbMaxRueckl;
    k.impactPct=(kdbBaseMax>0)?Math.max(-100,Math.min(100,(Number(k.impact)||0)/kdbBaseMax*100)):0;
  });
  kdbs.sort((a,b)=>(b.it-a.it)||(b.impact-a.impact));

  at.sort(sortToursForRanking);
  // Bereichs-Ampel nach höchster Bewertungsanzahl:
  // Die Tour mit den meisten Rückläufern/Bewertungen im jeweiligen Bereich gibt den Maximal-Impact für ALLE Touren dieses Bereichs vor.
  // Beispiel: höchste Bewertungsanzahl im Küchenbereich = 20 und Max +4 je Bewertung => Max-Impact für jede Küchentour = 80.
  const areaBases={};
  for(const ar of [...new Set(at.map(t=>t.bereich))]){
    const rated=at.filter(t=>t.bereich===ar&&t.hatBewertungen);
    const maxRueckl=rated.reduce((m,t)=>Math.max(m,Number(t.rueckl)||0),0);
    const maxRuecklTour=(rated.slice().sort((a,b)=>(Number(b.rueckl)||0)-(Number(a.rueckl)||0)||(Number(b.impact)||0)-(Number(a.impact)||0))[0]||{}).tour||'';
    const baseMax=maxRueckl>0?Math.max(1,maxRueckl*(rules.maxPos||4)):0;
    const green=Math.ceil(baseMax*.775), yellow=Math.ceil(baseMax*.6);
    areaBases[ar]={max:baseMax,green,yellow,maxRueckl,maxRuecklTour};
    at.filter(t=>t.bereich===ar).forEach(t=>{
      t.maxImpact=baseMax;t.greenAb=green;t.yellowAb=yellow;
      t.impactPct=(baseMax>0&&t.hatBewertungen)?Math.max(-100,Math.min(100,(Number(t.impact)||0)/baseMax*100)):0;
      t.areaMaxRueckl=maxRueckl;
      t.areaMaxRuecklTour=maxRuecklTour;
    });
  }
  at.sort(sortToursForRanking);
  const ba={};
  for(const t of at.filter(t=>t.hatBewertungen)){
    if(!ba[t.bereich])ba[t.bereich]={bereich:t.bereich,rueckl:0,impact:0,maxImpact:0,greenAb:0,yellowAb:0,maxRueckl:t.areaMaxRueckl||0,maxRuecklTour:t.areaMaxRuecklTour||''};
    ba[t.bereich].rueckl+=t.rueckl;ba[t.bereich].impact+=t.impact;ba[t.bereich].maxImpact+=t.maxImpact;ba[t.bereich].greenAb+=t.greenAb;ba[t.bereich].yellowAb+=t.yellowAb;
  }
  const bereiche=Object.values(ba).map(b=>({...b,impactPct:targetScorePct(b.impact,b)})).sort(sortToursForRanking);
  const g={rueckl:records.length,impact:records.reduce((s,r)=>s+r.impact,0),krit:records.filter(r=>r.krit).length,nps:records.length>0?records.reduce((s,r)=>s+r.nps,0)/records.length:0,csatOk:records.filter(r=>r.csat>=4).length,days:daysInfo.usedDays,first:daysInfo.first,last:daysInfo.last};
  return{kdbs,touren:at,bereiche,gesamt:g,daysInfo};
}


const COLOR_AREAS=['KDBS','Möbel','Liefertour','Küche','Kundendienst'];
function cleanAreaName(area){
  const a=String(area||'').trim();
  if(a==='KDB'||a==='KDB-Ranking'||a==='Kundenbetreuer')return 'KDBS';
  return a||'GLOBAL';
}
function loadColorSettings(){
  try{
    const raw=JSON.parse(localStorage.getItem('csatColorSettings')||'{}');
    const out={};
    COLOR_AREAS.forEach(a=>{
      const x=raw[a]||{};
      out[a]={green:(x.green===''||x.green===undefined||x.green===null)?'':Number(x.green),yellow:(x.yellow===''||x.yellow===undefined||x.yellow===null)?'':Number(x.yellow)};
      if(isNaN(out[a].green))out[a].green='';
      if(isNaN(out[a].yellow))out[a].yellow='';
    });
    return out;
  }catch(e){
    const out={};COLOR_AREAS.forEach(a=>out[a]={green:'',yellow:''});return out;
  }
}
let COLOR_SETTINGS=loadColorSettings();
function saveColorSettings(){localStorage.setItem('csatColorSettings',JSON.stringify(COLOR_SETTINGS));}
function autoColorThreshold(area){
  const a=cleanAreaName(area);
  const cfg=(SR&&SR.area&&(SR.area[a]||SR.area[area]))||null;
  // Automatisch: wenn Excel-Prozentwerte vorhanden sind, diese nutzen; sonst Standard 77,5 / 60.
  const g=cfg&&cfg.greenPct!==undefined&&!isNaN(cfg.greenPct)?Number(cfg.greenPct)*100:77.5;
  const y=cfg&&cfg.yellowPct!==undefined&&!isNaN(cfg.yellowPct)?Number(cfg.yellowPct)*100:60;
  return {green:g,yellow:y,source:'auto'};
}
function colorThreshold(area){
  const a=cleanAreaName(area);
  const auto=autoColorThreshold(a);
  const m=(COLOR_SETTINGS&&COLOR_SETTINGS[a])||{};
  const hasG=m.green!==''&&m.green!==undefined&&!isNaN(Number(m.green));
  const hasY=m.yellow!==''&&m.yellow!==undefined&&!isNaN(Number(m.yellow));
  let green=clampPct(hasG?Number(m.green):auto.green);
  let yellow=clampPct(hasY?Number(m.yellow):auto.yellow);
  // Sicherheitsnetz: Gelb darf nie rechts von Grün liegen. Dadurch bleiben Balkenfarbe, Markierung und Text immer synchron.
  if(yellow>green)yellow=green;
  return {green,yellow,manualGreen:hasG,manualYellow:hasY,source:(hasG||hasY)?'manuell':'auto'};
}
function impactStatus(p,area){
  const val=Number(p)||0;
  if(val<0)return 'red';
  const th=colorThreshold(area);
  if(val>=th.green)return 'green';
  if(val>=th.yellow)return 'yellow';
  return 'red';
}
function impactColor(p,area){
  const s=impactStatus(p,area);
  return s==='green'?'#00a651':s==='yellow'?'#F5A800':'#CC0000';
}
function ac(p,area){const s=impactStatus(p,area);return s==='green'?'ag':s==='yellow'?'ay':'ar';}
function al(p,area){const s=impactStatus(p,area);return s==='green'?'GRÜN':s==='yellow'?'GELB':'ROT';}
function thresholdInfo(area){const th=colorThreshold(area);return `Gelb ab ${fmtPct(th.yellow)}% · Grün ab ${fmtPct(th.green)}%${th.source==='manuell'?' · manuell':' · automatisch'}`;}
function fmtPct(v){return (Math.round(Number(v)*10)/10).toString().replace('.',',');}

function clampPct(v){
  v=Number(v); if(isNaN(v))v=0; return Math.max(0,Math.min(100,v));
}
function thresholdTrackBg(area){
  if(!area)return 'rgba(255,255,255,0.10)';
  const th=colorThreshold(area);
  const y=clampPct(th.yellow), g=clampPct(th.green);
  return `linear-gradient(90deg,rgba(204,0,0,.22) 0%,rgba(204,0,0,.22) ${y}%,rgba(245,168,0,.22) ${y}%,rgba(245,168,0,.22) ${g}%,rgba(0,166,81,.22) ${g}%,rgba(0,166,81,.22) 100%)`;
}
function thresholdMarks(area){
  if(!area)return '';
  const th=colorThreshold(area);
  const y=clampPct(th.yellow), g=clampPct(th.green);
  return `<div style="position:absolute;left:${y}%;top:0;bottom:0;width:1.5px;background:#F5A800;box-shadow:0 0 5px #F5A800;z-index:5;opacity:.95"></div><div style="position:absolute;left:${g}%;top:0;bottom:0;width:1.5px;background:#00a651;box-shadow:0 0 5px #00a651;z-index:5;opacity:.95"></div>`;
}
function thresholdLegend(area,isA3){
  const th=colorThreshold(area);
  const y=clampPct(th.yellow), g=clampPct(th.green);
  const fs=isA3?'8px':'10px';
  return `<div style="position:relative;height:${isA3?'13px':'14px'};margin-top:4px;font-size:${fs};color:rgba(255,255,255,.36);line-height:1">
    <span style="position:absolute;left:0;top:0">0%</span>
    <span style="position:absolute;left:${y}%;top:0;transform:translateX(-50%);color:#F5A800;font-weight:900;white-space:nowrap">Gelb ${fmtPct(th.yellow)}%</span>
    <span style="position:absolute;left:${g}%;top:0;transform:translateX(-50%);color:#00a651;font-weight:900;white-space:nowrap">Grün ${fmtPct(th.green)}%</span>
