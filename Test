    newNPS.push([Math.min(von,bis),Math.max(von,bis),pts]);
  });
  SR.rulesCSAT.forEach((r,i)=>{
    const von=parseInt(document.getElementById('csat-von-'+i)?.value);
    const bis=parseInt(document.getElementById('csat-bis-'+i)?.value);
